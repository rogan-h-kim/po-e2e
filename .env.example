# Po-Cake — Supabase 팀 공유 기본 설정 (빌드에 주입됨)
#
# 사용법:
#   1) 이 파일을 복사해 `.env` 로 저장
#   2) 아래 값을 본인 Supabase 프로젝트 값으로 채움
#      (Supabase → Project Settings → API 에서 확인)
#   3) npm run build → dist 에 설정이 포함된 채로 빌드됨
#
# 이렇게 빌드해서 배포하면, 동료는 설치만 하면 입력 없이 바로 사용합니다.
# (개별 사용자는 익스텐션 ⚙ 에서 이 기본값을 덮어쓸 수 있음)
#
# 주의: anon key 는 공개 키라 배포본에 포함돼도 되지만, 접근 통제는 RLS 로 합니다.
#       .env 는 git 에 올리지 마세요 (.gitignore 처리됨).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_TABLE=scenarios
